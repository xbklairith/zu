  "sources": {
    "internal/store/db_linux.go": "//go:build linux\n\npackage store\n\nfunc dialect() string { return \"linux\" }\n\nfunc init() { register() }\n",
    "internal/store/db_windows.go": "//go:build windows\n\npackage store\n\nfunc dialect() string { return \"windows\" }\n",
    "internal/store/register.go": "package store\n\nfunc register() { _ = dialect() }\n\nfunc init() {}\n",
    "internal/store/store.go": "// Package store keeps orders.\npackage store\n\nimport (\n\t\"database/sql\"\n\t\"sync\"\n\n\t\"github.com/lib/pq\"\n\n\t\"example.com/shop/internal/money\"\n)\n\n// Reader reads orders.\ntype Reader interface {\n\tGet(id int) (Order, error)\n}\n\n// ReadWriter reads and writes orders.\ntype ReadWriter interface {\n\tReader\n\tPut(o Order) error\n}\n\n// Order is one order.\ntype Order struct {\n\tID    int\n\tTotal money.Cents\n}\n\n// Repo stores orders in memory.\ntype Repo struct {\n\tsync.Mutex\n\t*sql.DB\n\tpq.Driver\n\tcache map[int]Order\n\thook  func()\n}\n\n// Open returns an empty Repo.\nfunc Open() *Repo { return \u0026Repo{cache: map[int]Order{}} }\n\n// Get returns one order.\nfunc (r *Repo) Get(id int) (Order, error) {\n\tr.Lock()\n\tdefer r.Unlock()\n\to := r.cache[id]\n\tr.hook()\n\treturn o, r.check(o)\n}\n\nfunc (r *Repo) check(o Order) error {\n\t_ = money.Add(o.Total, money.Zero)\n\treturn nil\n}\n\n// Reset replaces the receiver, so its calls are not certain.\nfunc (r *Repo) Reset() {\n\tr = Open()\n\tr.check(Order{})\n}\n\n// Page is one page of results.\ntype Page[T any] struct {\n\tItems []T\n}\n\n// Len is the page size.\nfunc (p *Page[T]) Len() int { return len(p.Items) }\n",
    "internal/store/zz_generated.go": "// Copyright 2026 The Shop Authors.\n// SPDX-License-Identifier: Apache-2.0\n\n// Code generated by stringer. DO NOT EDIT.\n\npackage store\n\n// Status is an order status.\ntype Status int\n\nfunc (s Status) String() string { return \"status\" }\n"
