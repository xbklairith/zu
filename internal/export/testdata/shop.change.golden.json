  "sources": {
    "internal/checkout/checkout.go": "// Package checkout prices carts.\npackage checkout\n\nimport (\n\t\"errors\"\n\n\t. \"example.com/shop/internal/money\"\n\tst \"example.com/shop/internal/store\"\n\t\"golang.org/x/sync/errgroup\"\n)\n\n// Cart is what a customer buys.\ntype Cart struct {\n\tst.Order\n\tLines []Line\n}\n\n// Line is one priced item.\ntype Line struct{ Price Cents }\n\n// Total sums a cart.\nfunc Total(c *Cart) Cents {\n\tif c == nil {\n\t\treturn 0\n\t}\n\tvar sum Cents\n\tfor _, l := range c.Lines {\n\t\tsum = Plus(sum, l.Price)\n\t}\n\treturn sum\n}\n\n// Place validates and stores a cart.\nfunc Place(c *Cart) error {\n\trepo := st.Open()\n\tif _, err := repo.Get(c.ID); err != nil {\n\t\treturn err\n\t}\n\tvar g errgroup.Group\n\tg.Go(func() error { return validate(c) })\n\treturn errors.New(\"todo\")\n}\n\nfunc validate(c *Cart) error {\n\tvalidate := func(*Cart) error { return nil }\n\treturn validate(c)\n}\n",
    "internal/money/money.go": "// Package money holds amounts.\npackage money\n\nimport \"example.com/shop/internal/store\"\n\nvar _ store.Order\n\n// Cents is an amount in cents.\ntype Cents int64\n\n// Currency is an ISO code.\ntype Currency = string\n\n// Zero is no money.\nconst Zero Cents = 0\n\n// Add returns the sum.\nfunc Plus(a, b Cents) Cents { return a + b }\n",
    "internal/store/store.go": "// Package store keeps orders.\npackage store\n\nimport (\n\t\"database/sql\"\n\t\"sync\"\n\n\t\"github.com/lib/pq\"\n\n)\n\n// Reader reads orders.\ntype Reader interface {\n\tGet(id int) (Order, error)\n}\n\n\n// Order is one order.\ntype Order struct {\n\tID    int\n\tTotal int64\n}\n\n// Repo stores orders in memory.\ntype Repo struct {\n\tsync.Mutex\n\t*sql.DB\n\tpq.Driver\n\tcache map[int]Order\n\thook  func()\n}\n\n// Open returns an empty Repo.\nfunc Open() *Repo { return \u0026Repo{cache: map[int]Order{}} }\n\n// Get returns one order.\nfunc (r *Repo) Get(id int) (Order, error) {\n\tr.Lock()\n\tdefer r.Unlock()\n\to := r.cache[id]\n\tr.hook()\n\tr.hook()\n\treturn o, r.check(o)\n}\n\nfunc (r *Repo) check(o Order) error {\n\treturn nil\n}\n\n// Reset replaces the receiver, so its calls are not certain.\nfunc (r *Repo) Reset() {\n\tr = Open()\n\tr.check(Order{})\n}\n\n// Page is one page of results.\ntype Page[T any] struct {\n\tItems []T\n}\n\n// Len is the page size.\nfunc (p *Page[T]) Len() int { return len(p.Items) }\n",
    "main.go": "package main\n\nimport (\n\t\"fmt\"\n\n\t\"example.com/shop/internal/checkout\"\n\t\"example.com/shop/internal/money\"\n\t_ \"example.com/shop/internal/missing\"\n)\n\nfunc main() {\n\tfmt.Println(checkout.Total(nil), money.Zero)\n}\n"
  },
